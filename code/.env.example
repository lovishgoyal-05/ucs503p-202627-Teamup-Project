POSTGRES_DB=teamup
POSTGRES_USER=teamup
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=jdbc:postgresql://localhost:5432/teamup
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-development
ADMIN_PASSCODE=replace-with-secure-admin-passcode
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Changeable application policy (no database migration required)
REFRESH_COOKIE_NAME=teamup_refresh
ACCESS_TOKEN_MINUTES=15
REFRESH_INACTIVITY_DAYS=7
ABSOLUTE_SESSION_DAYS=30
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
NOTIFICATION_LIMIT=100
DEFAULT_ROLE=STUDENT
OPTIONAL_SKILL_BONUS_MAX=10
