{
  "$schema": "https://openapi-schema.vercel.sh/vercel.json",
  "installCommand": "cd code/frontend && npm install",
  "buildCommand": "cd code/frontend && npm run build",
  "outputDirectory": "code/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://teamup-api-dah1.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://teamup-api-dah1.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://teamup-api-dah1.onrender.com/login/oauth2/:path*"
    },
    {
      "source": "/((?!api/|oauth2/|login/oauth2/).*)",
      "destination": "/index.html"
    }
  ]
}
